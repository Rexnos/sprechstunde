# Copy to ".env" (next to docker-compose.yml) to change these. All are optional.

# AI model (downloaded on first start). Pick by device:
#   NVIDIA/AMD GPU with 6 GB+ VRAM, or a Mac with 16 GB+:  qwen3.5:4b   (default, best corrections)
#   4 GB GPU, or a Mac with 8 GB:                          gemma3:4b or a 3B model
#   CPU only / older laptop:                               gemma3:1b    (fast, weaker corrections)
OLLAMA_MODEL=qwen3.5:4b

# Whisper size baked into the speech image: base (fastest) / small (default) / medium (most accurate, needs a GPU).
WHISPER_MODEL=small

# Pin Ollama releases for reproducible installs ("latest" / "rocm" otherwise).
OLLAMA_IMAGE_TAG=latest
OLLAMA_ROCM_TAG=rocm

# Port on this computer for the web app (always bound to 127.0.0.1 only).
APP_PORT=3000
