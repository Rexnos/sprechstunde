# Copy to .env.local and adjust. All services run on this PC (loopback only).
MONGODB_URI=mongodb://127.0.0.1:27017/local_language_tutor
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Exact Ollama tag you benchmarked (see README "Choosing a model"). Can be overridden per-user in Settings.
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=120000
SPEECH_SERVICE_URL=http://127.0.0.1:8001
SPEECH_TIMEOUT_MS=60000
# Default speech output for new profiles: piper | browser | off
TTS_MODE=piper
